# Copy to .env and fill in. .env is git-ignored and never leaves this machine.

# --- Configuration API (kepware_setup.py) ---
# The Kepware administrator account created during installation.
KEP_USER=Administrator
KEP_PASS=

# The Configuration API is a SEPARATE SERVICE from the OPC UA endpoint, on a
# different port and a different protocol:
#     57412  Configuration API over HTTP   <- this file
#     57512  Configuration API over HTTPS
#     49320  OPC UA (opc.tcp)              <- MES_OPC_ENDPOINT, not here
# Putting 49320 here sends HTTP at the binary UA port, and the only symptom
# is 'ConnectionResetError 10054', which reads like a dead server.
KEP_HOST=127.0.0.1
KEP_PORT=57412

# --- OPC UA (verify_readback.py) ---
# This install's UA endpoint requires SignAndEncrypt + a named user (no anonymous).
# Use a Kepware user account that has UA data access -- often the same admin.
UA_USER=Administrator
UA_PASS=
